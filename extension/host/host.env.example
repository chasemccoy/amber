# Copy to host.env (git-ignored) and fill in. Chrome launches the native host
# with a minimal environment, so secrets/config must be set here.

# Used for the Claude cleanup plan. Without it, amber falls back to heuristics.
ANTHROPIC_API_KEY=

# Where archives are written (default: ~/Documents/Archives).
# AMBER_ARCHIVE_DIR=/Users/you/Documents/Archives

# Trust a TLS-intercepting proxy (off by default).
# AMBER_INSECURE_TLS=1

# Override the model.
# AMBER_MODEL=claude-opus-4-8
